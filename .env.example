# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos de Gemini (gemini-1.5-flash fue dado de baja). El respaldo se usa si el principal está saturado
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# REST Countries v5 — clave gratuita en https://restcountries.com/sign-up
RESTCOUNTRIES_API_KEY=

# Puerto del servidor HTTP (en Render lo define la plataforma)
PORT=3000
